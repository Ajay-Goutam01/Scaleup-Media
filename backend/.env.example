# ============================================================
# ScaleUp Media Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/scaleup_media
# Production (MongoDB Atlas example):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/scaleup_media?retryWrites=true&w=majority

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_jwt_secret_minimum_64_chars
JWT_EXPIRES_IN=7d

# --- CORS ---
# Frontend URL (development)
CLIENT_URL=http://localhost:5173
# Frontend URL (production — set to your Vercel frontend URL)
# CLIENT_URL=https://your-scaleup-frontend.vercel.app

# --- ImageKit ---
# Get these from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
